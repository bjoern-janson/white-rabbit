{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "status.schema.json",
  "title": "White Rabbit provenance-bearing status",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "epistemic_role", "subject_id", "value", "scope", "effective_commit", "source_ids"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "epistemic_role": {"const": "NORMALIZED"},
    "subject_id": {"type": "string", "minLength": 1},
    "value": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "effective_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{7,64}$"},
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
