{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifact.schema.json",
  "title": "White Rabbit artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "epistemic_role", "artifact_type", "locator", "source_ids"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "epistemic_role": {"type": "string", "enum": ["SOURCE", "NORMALIZED", "DERIVED"]},
    "artifact_type": {"type": "string", "minLength": 1},
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "path", "commit"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-fA-F]{7,64}$"}
      }
    },
    "hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"type": "string", "enum": ["sha256", "git-blob-sha1"]},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "created_at": {"type": "string", "minLength": 1},
    "effective_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{7,64}$"},
    "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
