{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research_state.schema.json",
  "title": "White Rabbit research state",
  "type": "object",
  "additionalProperties": false,
  "required": ["constitution_version", "sources", "claims", "relations", "statuses", "experiments", "artifacts", "provenance"],
  "properties": {
    "constitution_version": {"const": "0.1"},
    "sources": {"type": "array"},
    "claims": {"type": "array"},
    "relations": {"type": "array"},
    "statuses": {"type": "array"},
    "experiments": {"type": "array"},
    "artifacts": {"type": "array"},
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "subject_id", "subject_role", "source_refs", "parent_normalized_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
          "subject_id": {"type": "string", "minLength": 1},
          "subject_role": {"type": "string", "enum": ["NORMALIZED", "DERIVED"]},
          "source_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_id", "source_locator", "subject_field"],
              "properties": {
                "source_id": {"type": "string", "minLength": 1},
                "source_locator": {"type": "string", "minLength": 1},
                "subject_field": {"type": "string", "minLength": 1}
              }
            }
          },
          "parent_normalized_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "derivation": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
