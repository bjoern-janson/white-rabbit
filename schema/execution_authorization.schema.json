{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bjoern-janson/white-rabbit/schema/execution_authorization.schema.json",
  "title": "White Rabbit Scientific Execution Authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assay_id",
    "status",
    "authorized",
    "target_constitution",
    "review_artifact",
    "scope",
    "authority_checkpoint"
  ],
  "properties": {
    "schema_version": {
      "const": "WHITE_RABBIT_EXECUTION_AUTHORIZATION_V0.1"
    },
    "assay_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "authorized": {
      "type": "boolean"
    },
    "target_constitution": {
      "type": "string",
      "minLength": 1
    },
    "target_implementation": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_artifact": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "authority_checkpoint": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string"
    }
  }
}
