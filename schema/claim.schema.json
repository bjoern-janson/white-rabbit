{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim.schema.json",
  "title": "White Rabbit bounded claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "epistemic_role", "proposition", "scope", "ceiling", "source_ids", "status_id"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "epistemic_role": {"type": "string", "enum": ["NORMALIZED", "DERIVED"]},
    "proposition": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "ceiling": {"type": "string", "minLength": 1},
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "status_id": {"type": "string", "minLength": 1}
  }
}
