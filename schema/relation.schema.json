{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "relation.schema.json",
  "title": "White Rabbit explicit relation",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "epistemic_role", "relation_type", "source_object_id", "target_object_id", "scope", "provenance_id"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "epistemic_role": {"type": "string", "enum": ["NORMALIZED", "DERIVED"]},
    "relation_type": {"type": "string", "enum": ["SUPERSEDES", "REVISES", "INVALIDATES", "DEPENDS_ON", "REFINES"]},
    "source_object_id": {"type": "string", "minLength": 1},
    "target_object_id": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "provenance_id": {"type": "string", "minLength": 1}
  }
}
