-        c = self.action_outcomes.get(action_key)
+    @staticmethod
+    def _dominant(c: Counter[str] | None) -> str:
         if not c:
             return "unknown"
         return c.most_common(1)[0][0]
+
+    @staticmethod
+    def _context_level(state_key: str) -> int:
+        # state_key is fixed entirely from decision-time-visible level + frame.
+        return int(state_key.split(":", 1)[0])
+
+    def _level_promotion(self, level: int, action_key: tuple) -> tuple[str, int]:
+        """Return an outcome only when distinct states establish level invariance."""
+        doms = self.level_state_dominants.get((level, action_key), {})
+        if len(doms) < 2:
+            return "unknown", 0
+        values = set(doms.values())
+        if len(values) != 1:
+            return "unknown", 0
+        return next(iter(values)), len(doms)
+
+    def _global_promotion(self, action_key: tuple) -> tuple[str, int]:
+        """Return an outcome only when distinct levels establish invariance.
+
+        Any observed local contradiction in any level defeats the broader claim;
+        supporting local observations remain intact.
+        """
+        observed: dict[int, dict[str, str]] = {}
+        for (level, key), doms in self.level_state_dominants.items():
+            if key == action_key and doms:
+                observed[level] = doms
+
+        promoted: dict[int, str] = {}
+        for level in observed:
+            outcome, _ = self._level_promotion(level, action_key)
+            if outcome != "unknown":
+                promoted[level] = outcome
+        if len(promoted) < 2 or len(set(promoted.values())) != 1:
+            return "unknown", 0
+
+        candidate = next(iter(promoted.values()))
+        # A broader claim cannot survive a contrary local observation merely
+        # because that contrary level has not yet accumulated two states.
+        for doms in observed.values():
+            if any(outcome != candidate for outcome in doms.values()):
+                return "unknown", 0
+        return candidate, len(promoted)
+
+    def _scoped_outcomes(self, state_key: str, action_key: tuple) -> tuple[Counter[str], str]:
+        """Use the narrowest justified authority: state -> level -> global."""
+        local = self.state_action_outcomes.get((state_key, action_key))
+        if local:
+            return local, "local"
+
+        level = self._context_level(state_key)
+        outcome, support = self._level_promotion(level, action_key)
+        if outcome != "unknown":
+            return Counter({outcome: support}), "level"
+
+        outcome, support = self._global_promotion(action_key)
+        if outcome != "unknown":
+            return Counter({outcome: support}), "global"
+        return Counter(), "unknown"
+
+    def _dominant_prediction(self, state_key: str, action_key: tuple) -> tuple[str, str]:
+        c, scope = self._scoped_outcomes(state_key, action_key)
+        return self._dominant(c), scope
 
