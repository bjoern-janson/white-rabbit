  "claims": [
    {
      "id": "claim:WR-OBS-002:fresh-browser-windows",
      "epistemic_role": "NORMALIZED",
      "proposition": "The preserved report states that three separate fresh browser chat windows received the same C_improve prompt; this establishes browser/conversation separation only, not fresh backend inference state.",
      "scope": "Literal normalization of the independence statement in WR-OBS-002 raw custody.",
      "ceiling": "Browser-window independence only; no backend-state independence, persistence, learning, causality, or White Rabbit-effect inference.",
      "source_ids": [
        "source:WR-OBS-002:raw"
      ],
      "status_id": "status:WR-OBS-002:fresh-browser-windows"
    },
    {
      "id": "claim:WR-OBS-002:runtime-measurements",
      "epistemic_role": "NORMALIZED",
      "proposition": "The three preserved runs each report 65 freshly processed prompt-evaluation tokens; generated-token counts are 1246, 995, and 1038; generation rates are approximately 13.98, 14.14, and 13.83 tokens/s; stop n_tokens values are 1670, 1419, and 1462.",
      "scope": "Literal normalization of the three reported llama.cpp/UI measurement blocks.",
      "ceiling": "Measurement transcription only; prompt-evaluation counts are not relabeled reasoning tokens and no causal or capability interpretation is made.",
      "source_ids": [
        "source:WR-OBS-002:raw"
      ],
      "status_id": "status:WR-OBS-002:runtime-measurements"
    },
    {
      "id": "claim:WR-OBS-002:context-arithmetic",
      "epistemic_role": "DERIVED",
      "proposition": "For each preserved run, stop n_tokens minus generated tokens equals 424, and 424 minus the 65 freshly processed prompt tokens equals 359; this is arithmetic consistent with substantial retained/common prefix state but is not a primary cached-token measurement.",
      "scope": "Deterministic arithmetic over claim:WR-OBS-002:runtime-measurements only.",
      "ceiling": "Arithmetic consistency statement only; does not identify exact cache mechanism or promote 359 into an explicitly measured cached-token counter.",
      "source_ids": [
        "source:WR-OBS-002:raw"
      ],
      "status_id": "status:WR-OBS-002:context-arithmetic"
    },
    {
      "id": "claim:WR-OBS-002:open-boundary",
      "epistemic_role": "NORMALIZED",
      "proposition": "WR-OBS-002 remains OPEN: backend-state independence is NOT_ESTABLISHED, C_improve causality is UNESTABLISHED, persistent policy change is UNESTABLISHED, capability improvement is NOT_DEMONSTRATED, White Rabbit effect is NOT_DEMONSTRATED, and mechanism remains OPEN.",
      "scope": "Literal normalization of the observation boundary recorded in WR-OBS-002 raw custody.",
      "ceiling": "Open observation boundary only; no scientific adjudication or treatment authorization.",
      "source_ids": [
        "source:WR-OBS-002:raw"
      ],
      "status_id": "status:WR-OBS-002:open-boundary"
    }
  ],
