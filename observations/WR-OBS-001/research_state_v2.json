  "claims": [
    {
      "id": "claim:WR-OBS-001:reported-hi-pair",
      "epistemic_role": "NORMALIZED",
      "proposition": "The preserved Pair A report records the `hi` reasoning display as 371 tokens, 28s, 13.04 tokens/s earlier and 11 tokens, 0.4s, 24.89 tokens/s later; final-generation throughput is recorded as 14.34 t/s earlier and 14.33 t/s later.",
      "scope": "Literal normalization of the user-reported Pair A UI measurements preserved in WR-OBS-001 raw custody.",
      "ceiling": "A transcription claim about reported UI measurements only; no causal, persistence, mechanism, or White Rabbit-effect inference.",
      "source_ids": [
        "source:WR-OBS-001:raw"
      ],
      "status_id": "status:WR-OBS-001:reported-hi-pair"
    },
    {
      "id": "claim:WR-OBS-001:O1",
      "epistemic_role": "DERIVED",
      "proposition": "Within the preserved Pair A report, the displayed reasoning-token count differs by 360 tokens between the earlier and later `hi` observations, while final-generation throughput differs by 0.01 t/s at the precision displayed.",
      "scope": "Deterministic arithmetic over claim:WR-OBS-001:reported-hi-pair only.",
      "ceiling": "A derived arithmetic observation that reported reasoning work changed; it does not identify the cause of that change.",
      "source_ids": [
        "source:WR-OBS-001:raw"
      ],
      "status_id": "status:WR-OBS-001:O1"
    },
    {
      "id": "claim:WR-OBS-001:open-boundary",
      "epistemic_role": "NORMALIZED",
      "proposition": "WR-OBS-001 remains OPEN: C_improve causal attribution is UNESTABLISHED, persistent policy change is UNESTABLISHED, White Rabbit effect is NOT_DEMONSTRATED, amortization is UNMEASURED, and mechanism is UNKNOWN.",
      "scope": "Literal normalization of the observation boundary recorded in WR-OBS-001 raw custody.",
      "ceiling": "Open-lead boundary only; no scientific adjudication of C_improve, runtime/session effects, persistence, amortization, or mechanism.",
      "source_ids": [
        "source:WR-OBS-001:raw"
      ],
      "status_id": "status:WR-OBS-001:open-boundary"
    },
    {
      "id": "claim:WR-OBS-001:backend-corrected",
      "epistemic_role": "NORMALIZED",
      "proposition": "The backend trace classifies 371 and 11 as freshly processed prompt-evaluation token counts, not generated reasoning-token counts. The two `hi` runs have approximately equal 370-token pre-generation/context lengths; the later request explicitly used LCP/prefix reuse, and generation increased from 44 to 88 tokens. Reasoning-work reduction is therefore NOT_DEMONSTRATED by the 371->11 pair.",
      "scope": "Backend measurement correction for WR-OBS-001 Pair A only.",
      "ceiling": "Measurement reclassification and supersession of the earlier reasoning-token interpretation; no C_improve causality, persistence, amortization, or White Rabbit effect.",
      "source_ids": [
        "source:WR-OBS-001:backend-correction"
      ],
      "status_id": "status:WR-OBS-001:backend-corrected"
    },
    {
      "id": "claim:WR-INSTRUMENTATION-001:cache-accounting",
      "epistemic_role": "NORMALIZED",
      "proposition": "A computation-saving claim must account for the cost of creating any reusable state that makes the saving possible; fresh browser chat is not sufficient evidence of fresh compute; cached/reused state must be separated from current-run execution accounting.",
      "scope": "White Rabbit instrumentation and accounting discipline only.",
      "ceiling": "Engineering measurement invariant; it does not establish a White Rabbit effect or any C_improve mechanism.",
      "source_ids": [
        "source:WR-INSTRUMENTATION-001"
      ],
      "status_id": "status:WR-INSTRUMENTATION-001:cache-accounting"
    }
  ],
